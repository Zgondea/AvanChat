# Database Configuration
DATABASE_URL=postgresql://postgres:secure_password_123@postgres:5432/chat_legislativ
POSTGRES_DB=chat_legislativ
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_123

# Redis Configuration
REDIS_URL=redis://:redis_password_123@redis:6379/0
REDIS_PASSWORD=redis_password_123

# Ollama Configuration
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:2b

# Application Configuration
SECRET_KEY=your-secret-key-change-this-vm-production
ENVIRONMENT=production
DEBUG=false

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Upload Configuration
MAX_FILE_SIZE=50000000  # 50MB
UPLOAD_DIRECTORY=./uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# AI Configuration (Optimized for speed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=300
CHUNK_OVERLAP=30
MAX_TOKENS=512
SIMILARITY_THRESHOLD=0.3
MAX_RESULTS=3

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log